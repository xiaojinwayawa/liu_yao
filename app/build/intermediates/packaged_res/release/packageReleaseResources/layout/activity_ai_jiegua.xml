<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/paper_bg"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/padding_screen">

        <!-- 标题栏 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/card_bg"
            android:elevation="@dimen/card_elevation"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="@dimen/padding_card">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/ai_title"
                android:textColor="@color/ink_black"
                android:textSize="@dimen/text_size_lg"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_xs"
                android:text="@string/ai_subtitle"
                android:textColor="@color/ink_gray"
                android:textSize="@dimen/text_size_xs" />
        </LinearLayout>

        <!-- 第一栏：输入问题 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_md"
            android:background="@drawable/card_bg"
            android:elevation="@dimen/card_elevation"
            android:orientation="vertical"
            android:padding="@dimen/padding_card">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/spacing_sm"
                android:text="@string/ai_question_label"
                android:textColor="@color/accent"
                android:textSize="@dimen/text_size_md"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/etQuestion"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/input_bg"
                android:gravity="top"
                android:hint="@string/ai_question_hint"
                android:inputType="textMultiLine"
                android:maxLines="10"
                android:minLines="5"
                android:padding="@dimen/spacing_sm"
                android:textColor="@color/ink_black"
                android:textColorHint="@color/ink_light"
                android:textSize="@dimen/text_size_sm" />
        </LinearLayout>

        <!-- 第二栏：解卦结果 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_md"
            android:background="@drawable/card_bg"
            android:elevation="@dimen/card_elevation"
            android:orientation="vertical"
            android:padding="@dimen/padding_card">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/spacing_sm"
                android:text="@string/ai_result_label"
                android:textColor="@color/accent"
                android:textSize="@dimen/text_size_md"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvResult"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:lineSpacingExtra="6dp"
                android:minHeight="200dp"
                android:text="@string/ai_result_hint"
                android:textColor="@color/ink_light"
                android:textSize="@dimen/text_size_sm" />
        </LinearLayout>

        <!-- 解卦按钮（位于第二个栏下方） -->
        <TextView
            android:id="@+id/btnJieGua"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_sm"
            android:background="@drawable/btn_primary"
            android:gravity="center"
            android:padding="@dimen/spacing_md"
            android:text="@string/ai_btn_jiegua"
            android:textColor="@color/on_primary"
            android:textSize="@dimen/text_size_md"
            android:textStyle="bold" />

    </LinearLayout>
</ScrollView>